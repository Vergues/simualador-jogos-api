<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================
         SPRING BOOT
         ===================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <!-- =====================================================
         INFORMAÇÕES DO PROJETO
         ===================================================== -->
    <groupId>com.vergues</groupId>
    <artifactId>simulador-jogos-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>simulador-jogos-api</name>

    <description>
        API para simulação de partidas de futebol
    </description>

    <!-- =====================================================
         CONFIGURAÇÕES
         ===================================================== -->
    <properties>

        <!-- Versão do Java -->
        <java.version>21</java.version>

    </properties>

    <!-- =====================================================
         DEPENDÊNCIAS
         ===================================================== -->
    <dependencies>

        <!--
            Spring MVC.
            Responsável pelos Controllers, endpoints REST,
            JSON, servidor web etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!--
            Spring Data JPA.

            Vamos usar para salvar jogos, eventos,
            estatísticas e outros dados no banco.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Banco H2.

            Não precisa instalar nada no computador.
            Vamos configurar o banco para salvar em arquivo,
            portanto os dados não somem quando o Spring fecha.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =====================================================
         BUILD
         ===================================================== -->
    <build>

        <plugins>

            <!-- Permite executar/empacotar o Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>
